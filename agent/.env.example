# Standalone (development) settings for the agent. Copy to .env — git ignores .env.
# Not used when the agent runs as a Home Assistant app; set options in the app's
# Configuration tab instead.

# The cloud API (Docker Compose on your PC). From the same machine: http://127.0.0.1:8000
HOMEWATCH_API_URL=http://127.0.0.1:8000
# Printed once by: docker compose run --rm api python -m app.cli create-home home-001
HOMEWATCH_API_KEY=hwk_paste_your_key_here

# Either the fake HA from tools/fake_ha.py (token "fake-token")...
HA_URL=http://127.0.0.1:8123
HA_TOKEN=fake-token
# ...or your real Home Assistant, with a long-lived access token
# (your HA profile > Security > Long-lived access tokens). Home Assistant OS
# installed from 2026.8 on listens on port 80, so no port; older installs use :8123.
# HA_URL=http://homeassistant.local
# HA_TOKEN=eyJ...

HOMEWATCH_HEARTBEAT_S=60
HOMEWATCH_PLATFORMS=zha
HOMEWATCH_OUTBOX=homewatch_outbox.db
HOMEWATCH_LOG_LEVEL=INFO
