# Copy to .env and fill in. Git ignores .env — never commit it.

# Database password. Long and random, letters and digits only (it goes inside a URL).
# Generate one:  python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=change-me

# How often the watchdog checks every home, in seconds.
WATCHDOG_INTERVAL_S=30
ALERT_TIMEZONE=America/New_York

# Optional: push alerts to your phone with the free ntfy app (https://ntfy.sh).
# Use a long random topic — anyone who knows the URL can read your alerts.
# Example: NTFY_URL=https://ntfy.sh/homewatch-9f2c7e1a5b8d4c03
NTFY_URL=
NTFY_TOKEN=

LOG_LEVEL=INFO
